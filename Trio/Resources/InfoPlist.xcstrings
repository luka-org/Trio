    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - Alarm Kit Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio používá alarmy, aby vás naléhavá upozornění na glykémii a inzulinovou pumpu zastihla i při ztlumeném telefonu nebo zapnutém režimu Soustředění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio nutzt Alarme, damit dich dringende Glukose- und Pumpen-Warnmeldungen auch dann erreichen, wenn dein Telefon stummgeschaltet ist oder ein Fokus-Modus aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio utilise des alarmes afin que les alertes urgentes de glucose et de pompe puissent vous parvenir même lorsque votre téléphone est en mode Silence ou qu'un mode Concentration est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio는 휴대폰 소리가 꺼진 상태나 '집중 모드' 사용 중에도 긴급한 혈당 및 펌프 경고가 사용자에게 전달되도록 알림 기능을 사용합니다."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio bruker alarmer slik at viktige glukose- og pumpevarslinger kan høres, selv om telefonen er i stille- eller fokusmodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio maakt gebruik van alarmen, zodat je dringende glucose- en pompwaarschuwingen kunt ontvangen zelfs als je telefoon wordt uitgezet of een Focus is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio wykorzystuje alarmy, dzięki którym pilne powiadomienia dotyczące poziomu glikemii oraz alerty z pompy dotrą do Ciebie nawet wtedy, gdy telefon jest wyciszony lub włączony jest tryb skupienia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Trio usa alarmes para que alertas urgentes de glicose e da bomba cheguem até você mesmo quando o telefone estiver no silencioso ou com um modo Foco ativado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio uses alarms so urgent glucose and pump alerts can reach you even when your phone is silenced or a Focus is on."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sử dụng báo thức để các cảnh báo khẩn cấp về đường huyết và bơm có thể đến được với bạn ngay cả khi điện thoại đang ở chế độ im lặng hoặc đang bật Chế độ Tập trung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 使用独立告警机制，即使手机静音或者开启专注模式，紧急血糖告警与泵体告警依然能够送达你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 使用警報，讓緊急血糖與幫浦警示即使在你的手機為靜音或啟用 Focus 時，也能傳達給你。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth се използва за комуникация с инсулинова помпа и CGM устройства"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth se používá ke komunikaci s inzulínovou pumpou a zařízeními pro kontinuální monitorování glykémie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wird verwendet, um mit Insulinpumpen und CGMs zu kommunizieren"
          }
