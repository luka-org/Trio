          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth được sử dụng để liên lạc với máy bơm insulin và các thiết bị theo dõi đường huyết liên tục"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝牙用于与胰岛素泵和动态血糖仪设备进行通信"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
