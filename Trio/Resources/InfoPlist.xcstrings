        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bluetooth est utilisé pour communiquer avec les pompes à insuline et les capteurs de glucose en continu (CGM)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Bluetooth viene utilizzato per comunicare con il microinfusore e i dispositivi di monitoraggio continuo del glucosio"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인슐린 펌프 및 연속혈당측정기(CGM)와 통신하기 위해 블루투스가 사용됩니다."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth brukes til å kommunisere med insulinpumpe og CGM"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wordt gebruikt om te communiceren met de insuline pomp en de continue glucose meter"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth jest używany do komunikacji z pompą insulinową i urządzeniami do ciągłego monitorowania glikemii"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bluetooth é usado para se comunicar com a bomba de insulina e dispositivos de monitoramento contínuo de glicose"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
